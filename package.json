{
  "name": "portfolio",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "knip": "knip",
    "check": "npm run lint && npm run format:check && npm run typecheck && npm run knip && npm test",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "postbuild": "node scripts/prerender.mjs",
    "mocks": "node scripts/mocks/render.mjs",
    "images": "node scripts/images.mjs",
    "og": "node scripts/og.mjs",
    "cv": "node scripts/cv/cv.mjs"
  },
  "dependencies": {
    "vue": "3.5.45",
    "vue-router": "5.5.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.1",
    "@types/node": "22.20.5",
    "@vitejs/plugin-vue": "6.0.11",
    "@vue/test-utils": "2.6.0",
    "eslint": "10.15.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-vue": "10.12.1",
    "globals": "^17.14.0",
    "jsdom": "31.0.1",
    "knip": "^5.88.1",
    "prettier": "3.10.1",
    "sharp": "^0.35.5",
    "typescript": "6.0.3",
    "typescript-eslint": "8.73.0",
    "vite": "8.3.8",
    "vitest": "5.1.1",
    "vue-tsc": "3.3.14"
  },
  "overrides": {
    "editorconfig": {
      "minimatch": "^11.0.9"
    },
    "js-beautify": {
      "glob": "^14.0.6"
    }
  }
}
